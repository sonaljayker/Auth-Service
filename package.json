{
  "name": "auth-service-docker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:up": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "dev:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "uat:up": "docker-compose -f docker-compose.yml -f docker-compose.uat.yml up -d --build",
    "uat:down": "docker-compose -f docker-compose.yml -f docker-compose.uat.yml down",
    "prod:up": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "logs": "docker-compose -f docker-compose.yml logs -f",
    "build:backend": "powershell -Command \"cd backend; .\\mvnw.cmd clean package -DskipTests\"",
    "run:backend": "powershell -Command \"cd backend; .\\mvnw.cmd spring-boot:run\""
  }
}
